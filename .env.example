# Public frontend configuration; generated in .env.local by `pnpm exec convex dev`.
VITE_CONVEX_URL=https://your-development-deployment.convex.cloud

# Configure these on Convex, never in the frontend:
# SITE_URL, JWT_PRIVATE_KEY, JWKS
# AUTH_ALLOWED_ORIGINS (comma-separated exact additional frontend origins)
# AUTH_GITHUB_ID, AUTH_GITHUB_SECRET
# AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET
